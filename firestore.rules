rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection validation probe document
    match /test/connection {
      allow read: if true;
    }

    // Common Security Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Administrator Authorization (Custom Claim, Trusted Admin Collection, or Verified Bootstrap Owner)
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'matimbangobeni78@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Helpers
    function isValidUserProfile(data, userId) {
      return data.userId == userId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100;
    }

    function isValidHabit(data, userId) {
      return data.userId == userId
        && isValidId(data.id)
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 150;
    }

    function isValidHabitLog(data, userId) {
      return data.userId == userId
        && isValidId(data.habitId)
        && data.date is string
        && data.date.size() <= 20
        && data.completed is bool;
    }

    function isValidTokenTransaction(data, userId) {
      return data.userId == userId
        && isValidId(data.id)
        && data.type is string
        && data.type.size() <= 50
        && data.amount is number;
    }

    function isValidMilestoneClaim(data, userId) {
      return data.userId == userId
        && isValidId(data.id)
        && isValidId(data.habitId)
        && isValidId(data.milestoneId)
        && data.cycle is int;
    }

    function isValidAppSettings(data, userId) {
      return data.userId == userId;
    }

    function isValidDailyMetrics(data) {
      return data.date is string
        && data.date.size() > 0
        && data.date.size() <= 20;
    }

    // Trusted Admin Access Control List (Read only for verified admins, no self-promotion)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Aggregate Daily Usage Metrics (Privacy Preserving: Only aggregate counts, zero individual data)
    match /daily_metrics/{metricId} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn() && isValidDailyMetrics(incoming());
      allow delete: if isAdmin();
    }

    // User Directory: Admin can list profiles with minimal account info (never habits or logs)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // Strict Zero-Trust Privacy: Habits are ONLY accessible by the owner
      match /habits/{habitId} {
        allow read, write: if isOwner(userId);
      }

      // Strict Zero-Trust Privacy: Logs are ONLY accessible by the owner
      match /logs/{logId} {
        allow read, write: if isOwner(userId);
      }

      // Strict Zero-Trust Privacy: Transactions are ONLY accessible by the owner
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }

      // Strict Zero-Trust Privacy: Claims are ONLY accessible by the owner
      match /claims/{claimId} {
        allow read, write: if isOwner(userId);
      }

      // Strict Zero-Trust Privacy: Settings are ONLY accessible by the owner
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
